<mujoco model="mounted_mouse_operator">
  <compiler angle="radian"/>
  <option timestep="0.002" gravity="0 0 -9.81" integrator="implicitfast"/>
  <visual><global offwidth="640" offheight="480"/></visual>
  <default>
    <joint damping="1" armature="0.002"/>
    <geom friction="0.3 0.01 0.001" condim="3" contype="0" conaffinity="0"/>
  </default>
  <worldbody>
    <light pos="0 -0.4 1.3" dir="0 0 -1"/>
    <camera name="overview" pos="0.70 -0.85 0.85" xyaxes="0.8 0.6 0 -0.4 0.53 0.75"/>
    <geom name="table" type="box" pos="0.05 0 0.02" size="0.65 0.45 0.02"
          rgba="0.62 0.49 0.35 1"/>
    <body name="robot_base" pos="-0.22 -0.15 0.04">
      <geom type="cylinder" pos="0 0 0.03" size="0.06 0.03" rgba="0.2 0.25 0.3 1"/>
      <geom type="capsule" fromto="0 0 0.04 0 0 0.20" size="0.023"/>
      <body name="upper_arm" pos="0 0 0.20">
        <joint name="shoulder" axis="0 0 1" range="-2.8 2.8"/>
        <geom type="capsule" fromto="0 0 0 0.28 0 0" size="0.022"
              rgba="0.18 0.45 0.8 1"/>
        <body name="forearm" pos="0.28 0 0">
          <joint name="elbow" axis="0 0 1" range="-2.8 2.8"/>
          <geom type="capsule" fromto="0 0 0 0.28 0 0" size="0.018"
                rgba="0.15 0.65 0.75 1"/>
          <body name="mouse_mount" pos="0.28 0 0">
            <geom type="capsule" fromto="0 0 0 0 0 -0.15" size="0.009"
                  rgba="0.8 0.8 0.8 1"/>
            <body name="mouse" pos="0 0 -0.18">
              <!-- Small vertical compliance lets table contacts support the mouse. -->
              <joint name="mount_compliance" type="slide" axis="0 0 1" range="-0.002 0.002"
                     stiffness="2000" damping="5"/>
              <geom name="mouse_housing" type="box" size="0.045 0.028 0.020"
                    mass="0.08" rgba="0.13 0.14 0.17 1"/>
              <geom type="box" pos="0.015 -0.013 0.027" size="0.020 0.010 0.004"
                    rgba="0.4 0.4 0.4 1"/>
              <body name="left_button" pos="0.015 0.013 0.027">
                <joint name="button_down" type="slide" axis="0 0 1" range="-0.006 0"
                       stiffness="500" damping="0.7" armature="0.001"/>
                <geom name="left_button_top" type="box" size="0.020 0.010 0.004"
                      mass="0.01" rgba="0.85 0.25 0.2 1"/>
              </body>
              <body name="click_finger" pos="0.015 0.013 0.070">
                <joint name="finger_down" type="slide" axis="0 0 -1" range="0 0.025"
                       damping="5"/>
                <geom type="capsule" fromto="0 0 0 0 0 -0.012" size="0.005"
                      rgba="0.9 0.7 0.2 1"/>
                <geom name="fingertip" type="sphere" pos="0 0 -0.018" size="0.007"
                      mass="0.01" rgba="1 0.65 0.15 1"/>
              </body>
            </body>
          </body>
        </body>
      </body>
    </body>
  </worldbody>
  <contact>
    <pair geom1="mouse_housing" geom2="table" margin="0.0001"/>
    <!-- Adjacent welded bodies are normally excluded; this pair must collide. -->
    <pair geom1="fingertip" geom2="left_button_top"/>
  </contact>
  <actuator>
    <position joint="shoulder" kp="120" kv="16" ctrlrange="-2.8 2.8"/>
    <position joint="elbow" kp="120" kv="16" ctrlrange="-2.8 2.8"/>
    <position joint="finger_down" kp="1500" kv="65" ctrlrange="0 0.025"/>
  </actuator>
</mujoco>
